# =============================================================================
# Variables públicas (expuestas al navegador — prefijo NEXT_PUBLIC_)
# =============================================================================
NEXT_PUBLIC_APP_NAME="AI Builder"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# En Vercel, NEXT_PUBLIC_APP_URL es opcional: si falta o está vacía,
# el build usa https://$VERCEL_URL automáticamente.

# =============================================================================
# Variables privadas (solo servidor — nunca NEXT_PUBLIC_)
# =============================================================================
# NODE_ENV lo define Next.js / Vercel. No hace falta setearlo en local.
# NODE_ENV="development"

# Ejemplo de secreto de servidor (no se envía al cliente)
# DATABASE_URL="postgresql://user:password@localhost:5432/app"
# AUTH_SECRET="generate-a-long-random-string"
